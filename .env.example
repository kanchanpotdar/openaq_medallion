# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- OpenAQ ---
# Create/rotate your key at https://explore.openaq.org (account settings)
OPENAQ_API_KEY=replace_with_your_openaq_key

# --- PostgreSQL (used by docker-compose AND the Python pipeline) ---
POSTGRES_USER=openaq
POSTGRES_PASSWORD=replace_with_a_local_dev_password
POSTGRES_DB=openaq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
